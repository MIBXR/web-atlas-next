  ],
  "useCases": [
    "线下分享、行业内部讲话与私享会",
    "AI 产品发布与 demo day",
    "将文章或 Markdown 整理为网页演讲稿",
    "用同一套主题制作配图、封面与截图画布"
  ],
  "avoid": [
    "大段表格数据和高信息密度培训课件",
    "多人同时协作编辑演示文稿"
  ],
  "constraints": [
    "配图流程依赖 GPT-Image 2.0 / GPT-M 2.0 的宿主能力。",
    "两套风格使用各自的模板、主题与版式类；同一份演示文稿采用一套风格。"
  ],
