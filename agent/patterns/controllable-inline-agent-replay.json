{
  "schemaVersion": 1,
  "id": "controllable-inline-agent-replay",
  "pattern": {
    "id": "controllable-inline-agent-replay",
    "order": 191,
    "title": "可启停的内嵌桌面工作流回放",
    "category": "交互反馈",
    "experienceTypes": [
      "micro-motion",
      "structure"
    ],
    "summary": "用真实 DOM 编排桌面应用的多面板 Agent 工作流时间线，进入视口时自动演示，并提供暂停、继续与重播控制。",
    "mechanism": "在三栏桌面应用窗口（.tcw：左侧项目树、中栏 Agent 对话与 6 步日志、右栏 Diff / Browser 双标签面板）上构建一条 8.6 秒的 GSAP 时间线。当卡片滚入视口中央（top 50%）时自动武装并开播：依次推进 6 个任务步骤（旋转加载图标切换为完成对勾，同步弹出四色色板圆点与三张素材缩略图），右栏先在 Diff 标签下逐行浮现 6 个改动文件与 HTML 代码，4.55s 时滑动标签指示器切至 Browser 面板，以 clip-path 展开生成的完整网页并自动上下滚动检视、弹出 1440 与 390 校验标签。窗口右下角浮现单按钮控件（.tcw-control），随状态在 Pause、Play、Replay 间切换，播完后鼠标重新移入窗口也可触发重播。",
    "trigger": "卡片滚动至视口 50% 位置自动触发；点击右下角 .tcw-control 按钮，或播放完成后鼠标移入窗口。",
    "effect": "无需加载笨重的视频文件，在高分屏下保持文字与图标锐利，同时让观看者能随时暂停细看某一步的日志、Diff 代码或生成预览。",
    "useCases": [
      "AI Agent、IDE 插件或桌面开发工具的端到端工作流演示",
      "需要同时展示“对话指令 → 代码变更 → 实时预览”的产品卡片",
      "超过 5 秒、按无障碍规范需提供暂停入口的界面循环演示"
    ],
    "avoid": [
      "播放超过 5 秒却不提供任何暂停或重播控件",
      "用模糊低码率的录屏 GIF 替代可由简单 DOM 结构呈现的编辑器界面"
    ],
    "constraints": [
      "固定提交源码与对照结果见 demos/cases/taste-skill-site/fidelity.md。",
      "减少动态模式下不运行自动时间线，直接展示 6 步全部完成（data-s=\"done\"）且切至 Browser 预览面板的终态。"
    ],
    "composition": {
      "role": "support",
      "notes": "放在深色聚焦卡片内，通过底部暖橙辉光与外层随滚动展平的 3D 抬升（.tcw-lift）突出桌面应用质感。",
      "pairsWellWith": [
        "one-move-process-panels",
        "timed-platform-carousel",
        "viewport-animation-lifecycle"
      ],
      "conflicts": []
    },
    "parameters": [
      {
        "name": "工作流总时长与步骤节点",
        "value": "总长 8.6s；6 步区间 [0.7–1.55, 1.65–2.35, 2.45–3.15, 3.25–4.4, 4.5–5.4, 5.5–7.75]s",
        "note": "公开代码：demos/cases/taste-skill-site/js/app.js initTasteCode（module 97953）。"
      },
      {
        "name": "Diff 切 Browser 与页面检视时刻",
        "value": "4.55s 切换标签指示器（x: 88 → 0）；4.8s 展开网页；5.75s–7.75s 向下滚到底；7.75s–8.85s 滚回顶部",
        "note": "公开代码：js/app.js initTasteCode，6.2s 弹出 1440 / 390 校验通过徽章。"
      },
      {
        "name": "窗口入场展平变换",
        "value": "yPercent: 24 → 0，rotationX: 28° → 0°，scale: 0.88 → 1（top bottom 至 top 40% scrub）",
        "note": "公开代码：js/app.js initTasteCode。"
      }
    ],
    "prompt": "为目标页面实现「可启停的内嵌桌面工作流回放」：在深色展示卡内构建三栏桌面窗口（.tcw：左侧会话树、中间 Agent 简报与 6 条 [data-step] 步骤行、右侧 Diff 与 Browser 双面板）。随外层滚动将 .tcw-lift 由 rotationX 28°、scale 0.88 展平。当窗口进入视口 50% 时启动 8.6 秒 GSAP 时间线：依次将 6 个步骤由 data-s=\"run\"（旋转指示器）切换为 data-s=\"done\"（完成对勾）并弹出色板、缩略图与文件行数，同时在右侧 Diff 面板逐行显示新增文件与代码；在 4.55 秒处将右侧面板切换为 Browser，展开并上下滚动生成的真实页面预览、弹出多宽度通过标签。在右下角提供 .tcw-control 按钮，随 running / paused / done 状态切换 Pause、Play、Replay 图标与 aria-label，支持点击暂停/继续/重播以及完成后鼠标移入重播。减少动态模式下直接展示完成态。",
    "sources": [
      {
        "caseId": "taste-skill-site",
        "locator": "entries/cases/taste-skill-site.json#interaction/6",
        "observation": "TasteCode 桌面应用区在进入视口 50% 时自动启动 8.6 秒 GSAP 工作流时间线：左侧会话树与日志依次走过 6 个设计步骤并点亮四色色板与三张缩略图，右侧由 Changes 文件与代码 Diff 面板平滑切换到 Browser 预览面板、展开并上下滚动完整网页、弹出 1440 与 390 校验标签；右下角按钮随状态在 Pause、Play、Replay 之间切换，支持随时暂停、继续与悬停重播。",
        "evidence": "observed",
        "referenceUrl": "https://www.tasteskill.dev/",
        "capturedAt": "2026-11-19",
        "focus": {
          "target": ".tcw-stage",
          "label": "TasteCode 桌面工作流与启停按钮",
          "instruction": "观察窗口内左侧 6 步日志与右侧 Diff 切 Browser 的自动演示；点击窗口右下角的暂停/播放/重播按钮控制进度。"
        }
      }
