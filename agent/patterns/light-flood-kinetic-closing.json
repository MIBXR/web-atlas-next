{
  "schemaVersion": 1,
  "id": "light-flood-kinetic-closing",
  "pattern": {
    "id": "light-flood-kinetic-closing",
    "order": 190,
    "title": "光泛画布中的字标交接",
    "category": "滚动叙事",
    "experienceTypes": [
      "page-motion",
      "visual"
    ],
    "summary": "在终章粘性舞台中用多层 Canvas 绘制扩张的暖橙日冕、降落的夜幕与三级柔焦字层，驱动前后两句宣言在光色反转中完成交接。",
    "mechanism": "在粘性舞台（data-scene=\"light-flood\"）内建立日昼底、日冕核心（.lf-sun：halo 与 core 两张离屏模糊 Canvas）、夜幕遮罩（.lf-night：带 destination-out 椭圆柔边裁切的 Canvas）以及三层不同高斯模糊半径的 Canvas 文字副本（.lf-soft）。为消除大面积模糊渐变在低色深屏幕上的条带伪影，Canvas 像素写入前使用固定种子（0x2f6b1d3）的 xorshift 算法对半透明像素施加 ±1 确定性抖动。随滚动推进，日冕从 0.5 倍扩张至 3 倍铺满画面，随后夜幕从顶部降下，前半句（.lf-lead）逐层由实转柔焦并上移淡出，后半句（.lf-key）从三级柔焦收束为纯白清晰字标并平滑落位至视口 48% 高度，同时联动顶栏切入深色模式。",
    "trigger": "纵向滚动穿过终章粘性舞台（.scene.lf）。",
    "effect": "无需 WebGL 着色器即可获得无色带的电影级光泛反转与光学景深对焦字标，将阅读情绪推向高潮并无缝衔接到深色页脚。",
    "useCases": [
      "产品官网或战役落地页的终章宣言舞台",
      "从浅色正文区向深色页脚过渡的全屏情绪转场",
      "强调“从模糊猜测到清晰决策”主题的双句对偶标题"
    ],
    "avoid": [
      "单行超过 18 个字符、在窄屏下会折成三行以上的长句子",
      "需要放置密集按钮或表单字段的功能性区块"
    ],
    "constraints": [
      "固定提交源码与对照结果见 demos/cases/taste-skill-site/fidelity.md。",
      "当设备逻辑核心数不超过 4 或处于减少动态模式时，跳过多层 Canvas 模糊绘制，回退为 CSS 滤镜或静态双行排版。"
    ],
    "composition": {
      "role": "support",
      "notes": "位于长页正文末尾与深色页脚之间，既承担核心口号收束，又完成全页底色由暖白（#f8f4ee）向暖黑（#140a05）的翻转。",
      "pairsWellWith": [
        "hf-ground-canvas-close"
      ],
      "conflicts": []
    },
    "parameters": [
      {
        "name": "粘性行程与日冕缩放",
        "value": "hold = 2.3（手机 2.0）；日冕 scale 0.5 → 1.0 → 3.0 → 1.15（手机 0.6 → 1.2 → 3.6 → 1.3）",
        "note": "公开代码：demos/cases/taste-skill-site/js/light-flood.js。"
      },
      {
        "name": "三级柔焦模糊半径",
        "value": "前半句 leadBlur = [6, 3.4, 1.5]px（手机 [4, 2.3, 1]px）；后半句 keyBlur = [4, 2, 0.9]px（手机 [3, 1.5, 0.7]px）",
        "note": "公开代码：js/light-flood.js，后半句在进度 [0.165, 0.225, 0.285] 逐层聚焦，前半句在 [0.53, 0.565, 0.60] 逐层散焦退场。"
      },
      {
        "name": "防色带像素抖动种子",
        "value": "xorshift32 种子 0x2f6b1d3，alpha ∈ (0, 255) 施加 ±1 预乘抖动",
        "note": "公开代码：js/light-flood.js 函数 f(ctx, w, h)。"
      }
    ],
    "prompt": "为目标页面实现「光泛画布中的字标交接」：在页脚上方建立 data-scene=\"light-flood\" 的粘性舞台（hold=2.3）。在 .scene-stage 内依次生成 .lf-ground、.lf-sun（含 .lf-halo-tex 与 .lf-core-tex 两张 2D Canvas）、.lf-night（含 destination-out 椭圆柔边遮罩的 .lf-night-tex Canvas）、三层 .lf-soft 柔焦文字 Canvas 及主标题 h2.lf-line（包含 .lf-lead 前半句与 .lf-key 后半句）。对日冕与夜幕 Canvas 的半透明像素应用固定种子 0x2f6b1d3 的 xorshift ±1 抖动以消除渐变色带。随滚动将日冕放大铺满屏幕，让后半句经三级模糊半径 [4, 2, 0.9]px 聚焦显现；在进度 0.54 降下夜幕遮罩，使前半句经 [1.5, 3.4, 6]px 散焦上移淡出，后半句落位至视口高度 48% 并与深色页脚无缝衔接。",
    "sources": [
      {
        "caseId": "taste-skill-site",
        "locator": "entries/cases/taste-skill-site.json#interaction/7",
        "observation": "终章 Stop guessing, start deciding.（light-flood）在粘性视口内用多层二维 Canvas 绘制带确定性像素抖动的暖橙日冕（halo/core）、夜幕椭圆遮罩（night）与三级高斯模糊字层（lf-soft），随滚动推进日冕扩张与夜幕降落，使深色模糊的 Stop guessing, 上移淡出，亮白清晰的 start deciding. 从多层柔焦收束定格在视口中央。",
        "evidence": "observed",
        "referenceUrl": "https://www.tasteskill.dev/",
        "capturedAt": "2026-11-19",
        "focus": {
          "target": ".scene.lf .scene-stage",
          "label": "光泛画布与柔焦字标交接",
          "instruction": "在此粘性舞台上下滚动，观察暖橙日冕扩张、夜幕降下，以及 Stop guessing, 与 start deciding. 在多层柔焦间的对焦交接。"
        }
      }
